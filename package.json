{
  "name": "tal-ron-wedding",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/*.test.js",
    "emulators": "firebase emulators:start",
    "deploy": "npm run build && firebase deploy",
    "test:integration": "firebase emulators:exec --project demo-tal-ron --only auth,firestore,functions \"node --test test/integration.mjs\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/solitreo": "^5.3.0",
    "firebase": "^12.0.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "firebase-tools": "^14.7.0",
    "prettier": "^3.10.1",
    "vite": "^6.3.5"
  }
}
